# ============================================================================
# py-analyzer — Environment Configuration
# ============================================================================
# Copy this file to `.env` and modify values as needed.
#
# Example:
#   cp .env.example .env
#
# The TRACKER_AI_* variables may also be overridden automatically
# when invoked via the Rust tracker.
# ============================================================================


# ============================================================================
# AI Provider Configuration
# ============================================================================

# Supported:
# - ollama
# - openai (future)
# - anthropic (future)
TRACKER_AI_PROVIDER=ollama

# Enable/disable semantic AI summaries
TRACKER_AI_ENABLED=true


# ============================================================================
# Ollama Configuration
# ============================================================================

# Local Ollama API endpoint
TRACKER_AI_OLLAMA_HOST=http://localhost:11434

# Model used for semantic summaries
TRACKER_AI_MODEL=qwen2.5:7b


# ============================================================================
# Session / Storage Configuration
# ============================================================================

# Session directory containing normalized logs
TRACKER_SESSION_DIR=../sessions/active_session

# Normalized JSONL filename
TRACKER_NORMALIZED_FILE=normalized_sessions.jsonl

# Output directory for generated summaries
TRACKER_AI_OUTPUT_DIR=outputs


# ============================================================================
# Future External Provider Keys
# ============================================================================

# TRACKER_OPENAI_API_KEY=
# TRACKER_ANTHROPIC_API_KEY=
# TRACKER_OPENROUTER_API_KEY=


# ============================================================================
# Analyzer Behavior
# ============================================================================

# Retry attempts for failed semantic generation
TRACKER_AI_RETRY_ATTEMPTS=3

# Delay between retries in seconds
TRACKER_AI_RETRY_DELAY_SEC=30

# Generate semantic summaries automatically
TRACKER_AI_AUTO_SUMMARY=true